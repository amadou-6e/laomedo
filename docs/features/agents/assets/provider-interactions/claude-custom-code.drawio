        </mxCell>
        <mxCell id="adapter" value="&lt;b&gt;Packaged upstream ACP adapter&lt;/b&gt;&lt;br/&gt;claude-agent-acp&lt;br/&gt;&lt;br/&gt;Translate ACP to native Claude execution; raw SDK messages return through the shared ACP connection." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#E7F3EC;strokeColor=#8193A5;fontColor=#20384A;fontSize=14;" vertex="1" parent="col_0">
