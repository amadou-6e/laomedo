        <mxCell id="cli" value="&lt;b&gt;Claude native runtime&lt;/b&gt;&lt;br/&gt;claude executable&lt;br/&gt;&lt;br/&gt;Native subscription session and telemetry. Controller shell/file tools are disabled." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#E7F3EC;strokeColor=#8193A5;fontColor=#20384A;fontSize=14;" vertex="1" parent="col_0">
