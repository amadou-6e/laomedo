        <mxCell id="profile" value="&lt;b&gt;Dedicated Claude profile&lt;/b&gt;&lt;br/&gt;Mounted access/session volume&lt;br/&gt;&lt;br/&gt;Controller reads mirrored access credentials and persists the native session for Resume." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#E7F3EC;strokeColor=#8193A5;fontColor=#20384A;fontSize=14;" vertex="1" parent="col_2">
