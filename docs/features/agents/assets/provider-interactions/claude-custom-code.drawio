<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" type="device">
  <diagram id="grouped-erd" name="Claude custom code">
    <mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1785" pageHeight="1180">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="diagram-title" value="Claude | Where the custom code lives and why" vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=24;fontColor=#20384A;">
          <mxGeometry x="50" y="25" width="1720" height="45" as="geometry" />
        </mxCell>
        <mxCell id="diagram-note" value="CURRENT candidate 19c7f1f. Blue: Laomedo code. Green: upstream/shared dependencies. Amber: gaps. Provider-relative paths unless host/ or docker/ is shown." vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=12;fontColor=#9A6949;">
          <mxGeometry x="50" y="78" width="1720" height="45" as="geometry" />
        </mxCell>
        <mxCell id="host" value="Laomedo: provider-owned Python" style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;resizeChildren=0;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fillColor=#F5F7FA;strokeColor=#BDCBD6;fontColor=#20384A;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="35" y="237.5" width="350" height="415" as="geometry" />
        </mxCell>
        <mxCell id="agent" value="&lt;b&gt;ClaudeAgent : BaseAgent&lt;/b&gt;&lt;br/&gt;agent.py; shared ../base/agent.py&lt;br/&gt;&lt;br/&gt;Base shares admission and records. This subclass owns native binding, execution and finalization." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#EAF0FA;strokeColor=#8193A5;fontColor=#20384A;fontSize=15;" vertex="1" parent="host">
          <mxGeometry x="20" y="55" width="310" height="150" as="geometry" />
        </mxCell>
        <mxCell id="runtime" value="&lt;b&gt;ClaudeContainer&lt;/b&gt;&lt;br/&gt;container.py + models.py&lt;br/&gt;&lt;br/&gt;Create supervised per-turn controller scopes; enforce mounts, tool policy and exact cleanup." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#EAF0FA;strokeColor=#8193A5;fontColor=#20384A;fontSize=15;" vertex="1" parent="host">
          <mxGeometry x="20" y="240" width="310" height="150" as="geometry" />
        </mxCell>
        <mxCell id="shared" value="Host: common code and libraries" style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;resizeChildren=0;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fillColor=#F5F7FA;strokeColor=#BDCBD6;fontColor=#20384A;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="485" y="145" width="350" height="600" as="geometry" />
        </mxCell>
        <mxCell id="acp" value="&lt;b&gt;SHARED: Laomedo ACP bridge&lt;/b&gt;&lt;br/&gt;../base/acp/session.py + transport.py&lt;br/&gt;&lt;br/&gt;Compose the Python ACP SDK and adapt attached Docker stdin/stdout; native policy stays provider-owned." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#EAF0FA;strokeColor=#8193A5;fontColor=#20384A;fontSize=15;" vertex="1" parent="shared">
          <mxGeometry x="20" y="55" width="310" height="150" as="geometry" />
        </mxCell>
        <mxCell id="sdk" value="&lt;b&gt;UPSTREAM: ACP Python SDK&lt;/b&gt;&lt;br/&gt;agent-client-protocol 0.12.1&lt;br/&gt;&lt;br/&gt;Implements protocol schemas and JSON-RPC request/response handling." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#E7F3EC;strokeColor=#8193A5;fontColor=#20384A;fontSize=15;" vertex="1" parent="shared">
          <mxGeometry x="20" y="240" width="310" height="150" as="geometry" />
        </mxCell>
        <mxCell id="docker" value="&lt;b&gt;SHARED: container libraries&lt;/b&gt;&lt;br/&gt;py-docker -&amp;gt; Docker SDK -&amp;gt; Engine&lt;br/&gt;&lt;br/&gt;Open attached sessions, run jobs, retain ownership receipts and confirm exact-resource cleanup." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#E7F3EC;strokeColor=#8193A5;fontColor=#20384A;fontSize=15;" vertex="1" parent="shared">
          <mxGeometry x="20" y="425" width="310" height="150" as="geometry" />
        </mxCell>
        <mxCell id="container" value="Provider Docker controller" style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;resizeChildren=0;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fillColor=#F5F7FA;strokeColor=#BDCBD6;fontColor=#20384A;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="955" y="237.5" width="350" height="415" as="geometry" />
        </mxCell>
        <mxCell id="adapter" value="&lt;b&gt;UPSTREAM: Claude ACP adapter&lt;/b&gt;&lt;br/&gt;claude-agent-acp package&lt;br/&gt;&lt;br/&gt;Translates ACP into Claude-native execution. Installed in /opt/acp; no local adapter fork." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#E7F3EC;strokeColor=#8193A5;fontColor=#20384A;fontSize=15;" vertex="1" parent="container">
          <mxGeometry x="20" y="55" width="310" height="150" as="geometry" />
        </mxCell>
        <mxCell id="cli" value="&lt;b&gt;Upstream Claude CLI&lt;/b&gt;&lt;br/&gt;claude executable&lt;br/&gt;&lt;br/&gt;Owns native sessions, subscription requests and native telemetry; native shell/file tools are disabled." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#E7F3EC;strokeColor=#8193A5;fontColor=#20384A;fontSize=15;" vertex="1" parent="container">
          <mxGeometry x="20" y="240" width="310" height="150" as="geometry" />
        </mxCell>
        <mxCell id="external" value="External service / known gaps" style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;resizeChildren=0;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fillColor=#F5F7FA;strokeColor=#BDCBD6;fontColor=#20384A;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1405" y="222.5" width="300" height="445" as="geometry" />
        </mxCell>
        <mxCell id="model" value="&lt;b&gt;EXTERNAL: model service&lt;/b&gt;&lt;br/&gt;Outside the local Docker runner&lt;br/&gt;&lt;br/&gt;The native CLI authenticates and sends model requests. ACP does not perform inference." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#E7F3EC;strokeColor=#8193A5;fontColor=#20384A;fontSize=15;" vertex="1" parent="external">
          <mxGeometry x="20" y="55" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="gap" value="&lt;b&gt;Current boundary gap&lt;/b&gt;&lt;br/&gt;Not a validation claim&lt;br/&gt;&lt;br/&gt;ACP session ownership is inside Agent; shared lifecycle consolidation remains incomplete." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#FFF1DF;strokeColor=#8193A5;fontColor=#20384A;fontSize=15;" vertex="1" parent="external">
          <mxGeometry x="20" y="240" width="260" height="180" as="geometry" />
        </mxCell>
        <mxCell id="support" value="Supporting code: location and purpose" style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;resizeChildren=0;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fillColor=#F5F7FA;strokeColor=#BDCBD6;fontColor=#20384A;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="177.5" y="835" width="1385" height="265" as="geometry" />
        </mxCell>
        <mxCell id="support_0" value="&lt;b&gt;CUSTOM: command bridge&lt;/b&gt;&lt;br/&gt;docker/claude/command_mcp.py&lt;br/&gt;&lt;br/&gt;Expose admitted MCP tools to Claude; forward authenticated requests to the host command service." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#EAF0FA;strokeColor=#8193A5;fontColor=#20384A;fontSize=15;" vertex="1" parent="support">
          <mxGeometry x="20" y="55" width="310" height="185" as="geometry" />
        </mxCell>
        <mxCell id="support_1" value="&lt;b&gt;CUSTOM: isolated command service&lt;/b&gt;&lt;br/&gt;container.py: CommandService; http/&lt;br/&gt;&lt;br/&gt;Execute in a credential-free, network-disabled worker; authorize mediated GitHub effects separately." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#EAF0FA;strokeColor=#8193A5;fontColor=#20384A;fontSize=15;" vertex="1" parent="support">
          <mxGeometry x="365" y="55" width="310" height="185" as="geometry" />
        </mxCell>
        <mxCell id="support_2" value="&lt;b&gt;CUSTOM: access-only login mirror&lt;/b&gt;&lt;br/&gt;auth/ + auth/resources/write_login.py&lt;br/&gt;&lt;br/&gt;Mirror only approved access credentials into the dedicated profile; host retains refresh ownership." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#EAF0FA;strokeColor=#8193A5;fontColor=#20384A;fontSize=15;" vertex="1" parent="support">
          <mxGeometry x="710" y="55" width="310" height="185" as="geometry" />
        </mxCell>
        <mxCell id="support_3" value="&lt;b&gt;CUSTOM: native telemetry receiver&lt;/b&gt;&lt;br/&gt;activity/ + activity/http/&lt;br/&gt;&lt;br/&gt;Receive native OTLP, bind it to run/thread/turn and retain safe evidence without inventing usage." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#EAF0FA;strokeColor=#8193A5;fontColor=#20384A;fontSize=15;" vertex="1" parent="support">
          <mxGeometry x="1055" y="55" width="310" height="185" as="geometry" />
        </mxCell>
