        </mxCell>
        <mxCell id="auth" value="&lt;b&gt;Access-only login mirror&lt;/b&gt;&lt;br/&gt;claude/auth/; resources/write_login.py&lt;br/&gt;&lt;br/&gt;Copy only the approved access credential to the dedicated volume; host keeps refresh ownership." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#F0EAF8;strokeColor=#8193A5;fontColor=#20384A;fontSize=14;" vertex="1" parent="col_1">
