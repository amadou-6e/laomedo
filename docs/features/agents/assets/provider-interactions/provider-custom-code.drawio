        </mxCell>
        <mxCell id="cli" value="&lt;b&gt;[A] Claude native runtime&lt;/b&gt;&lt;br/&gt;claude executable&lt;br/&gt;&lt;br/&gt;Native subscription session and telemetry. Controller shell/file tools are disabled." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#E7F3EC;strokeColor=#8193A5;fontColor=#20384A;fontSize=14;" vertex="1" parent="col_0">
          <mxGeometry x="20" y="60" width="285" height="150" as="geometry" />
        </mxCell>
        <mxCell id="adapter" value="&lt;b&gt;[B] Packaged upstream ACP adapter&lt;/b&gt;&lt;br/&gt;claude-agent-acp&lt;br/&gt;&lt;br/&gt;Translate ACP to native Claude execution; raw SDK messages return through the shared ACP connection." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#E7F3EC;strokeColor=#8193A5;fontColor=#20384A;fontSize=14;" vertex="1" parent="col_0">
          <mxGeometry x="20" y="290" width="285" height="150" as="geometry" />
        </mxCell>
        <mxCell id="col_1" value="Provider receiver / shared wire" style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;resizeChildren=0;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fillColor=#F5F7FA;strokeColor=#BDCBD6;fontColor=#20384A;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="150" width="325" height="520" as="geometry" />
        </mxCell>
        <mxCell id="telemetry" value="&lt;b&gt;[C] Native OTLP receiver&lt;/b&gt;&lt;br/&gt;claude/activity/; activity/http/&lt;br/&gt;&lt;br/&gt;ClaudeTelemetry receives HTTP telemetry, binds native run/thread/turn and retains safe receipts." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#F0EAF8;strokeColor=#8193A5;fontColor=#20384A;fontSize=14;" vertex="1" parent="col_1">
          <mxGeometry x="20" y="60" width="285" height="150" as="geometry" />
        </mxCell>
        <mxCell id="acp" value="&lt;b&gt;[D] Shared ACP bridge + Python SDK&lt;/b&gt;&lt;br/&gt;agents/agents/base/acp/session.py; transport.py&lt;br/&gt;&lt;br/&gt;AcpSession composes the upstream ACP SDK. DockerTransport carries its frames over attached stdin/stdout." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#EAF0FA;strokeColor=#8193A5;fontColor=#20384A;fontSize=14;" vertex="1" parent="col_1">
          <mxGeometry x="20" y="290" width="285" height="150" as="geometry" />
        </mxCell>
