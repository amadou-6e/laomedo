  <diagram id="codex-tools-auth" name="2. Tools and credentials">
    <mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="2995" pageHeight="900">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="diagram-title" value="Codex | 2. Tools and credentials" vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=24;fontColor=#20384A;">
          <mxGeometry x="60" y="25" width="2115" height="45" as="geometry" />
        </mxCell>
        <mxCell id="diagram-note" value="OPTIONAL SPLIT PATH. Normal mode uses native execution. App-owned login is only one credential source. | Current runtime 19c7f1f. Paths are repository/package-relative as shown." vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=12;fontColor=#9A6949;">
          <mxGeometry x="60" y="78" width="2115" height="45" as="geometry" />
        </mxCell>
        <mxCell id="col_0" value="Optional host login / Docker" style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;resizeChildren=0;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fillColor=#F5F7FA;strokeColor=#BDCBD6;fontColor=#20384A;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="45" y="150" width="325" height="520" as="geometry" />
        </mxCell>
        <mxCell id="source" value="&lt;b&gt;[A] Host ChatGPT connection&lt;/b&gt;&lt;br/&gt;host/credentials/siwc/&lt;br/&gt;&lt;br/&gt;Optional app-owned login supplies the admitted access credential via CodexAgent; currently allowed only with Codex split mode." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#EAF0FA;strokeColor=#8193A5;fontColor=#20384A;fontSize=14;" vertex="1" parent="col_0">
          <mxGeometry x="20" y="60" width="285" height="150" as="geometry" />
        </mxCell>
        <mxCell id="docker" value="&lt;b&gt;[B] Shared Docker mechanics&lt;/b&gt;&lt;br/&gt;py-docker -&amp;gt; Docker SDK -&amp;gt; Engine&lt;br/&gt;&lt;br/&gt;Create/attach owned containers, execute jobs, retain receipts and reconcile cleanup." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#E7F3EC;strokeColor=#8193A5;fontColor=#20384A;fontSize=14;" vertex="1" parent="col_0">
          <mxGeometry x="20" y="290" width="285" height="150" as="geometry" />
        </mxCell>
        <mxCell id="col_1" value="Provider split resource owners" style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;resizeChildren=0;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fillColor=#F5F7FA;strokeColor=#BDCBD6;fontColor=#20384A;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="150" width="325" height="520" as="geometry" />
        </mxCell>
        <mxCell id="runtime" value="&lt;b&gt;[C] CodexController&lt;/b&gt;&lt;br/&gt;codex/controller/service.py&lt;br/&gt;&lt;br/&gt;Own the ACP session, native callbacks, output precheck and exact controller lifetime." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#F0EAF8;strokeColor=#8193A5;fontColor=#20384A;fontSize=14;" vertex="1" parent="col_1">
          <mxGeometry x="20" y="60" width="285" height="150" as="geometry" />
        </mxCell>
        <mxCell id="executor" value="&lt;b&gt;[D] Optional split executor&lt;/b&gt;&lt;br/&gt;codex/split/executor.py; models.py&lt;br/&gt;&lt;br/&gt;Controller creates/registers this separate execution resource. Native isolation remains unverified." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#F0EAF8;strokeColor=#8193A5;fontColor=#20384A;fontSize=14;" vertex="1" parent="col_1">
          <mxGeometry x="20" y="290" width="285" height="150" as="geometry" />
        </mxCell>
        <mxCell id="col_2" value="Controller admitted state" style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;resizeChildren=0;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fillColor=#F5F7FA;strokeColor=#BDCBD6;fontColor=#20384A;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="915" y="150" width="325" height="520" as="geometry" />
        </mxCell>
        <mxCell id="profile" value="&lt;b&gt;[E] Controller credential/session binding&lt;/b&gt;&lt;br/&gt;SplitLaunch; profile / environment&lt;br/&gt;&lt;br/&gt;Access may be launch-only. Bind native session state separately; no access credential reaches the executor." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#E7F3EC;strokeColor=#8193A5;fontColor=#20384A;fontSize=14;" vertex="1" parent="col_2">
