        <mxCell id="diagram-title" value="OpenCode | 1. Run and session" vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=24;fontColor=#20384A;">
          <mxGeometry x="60" y="25" width="2115" height="45" as="geometry" />
        </mxCell>
        <mxCell id="diagram-note" value="Blue: shared code. Purple: provider Python. Green: upstream/resources. Orange: custom controller code. | Current runtime 19c7f1f. Paths are repository/package-relative as shown." vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=12;fontColor=#9A6949;">
          <mxGeometry x="60" y="78" width="2115" height="45" as="geometry" />
        </mxCell>
        <mxCell id="col_0" value="App contract / launch input" style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;resizeChildren=0;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fillColor=#F5F7FA;strokeColor=#BDCBD6;fontColor=#20384A;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="45" y="150" width="325" height="520" as="geometry" />
        </mxCell>
        <mxCell id="entry" value="&lt;b&gt;[A] Application boundary + BaseAgent&lt;/b&gt;&lt;br/&gt;agents/interface/; agents/agents/base/agent.py&lt;br/&gt;&lt;br/&gt;Public operations, run admission and records. Concrete providers implement the native execution hooks." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#EAF0FA;strokeColor=#8193A5;fontColor=#20384A;fontSize=14;" vertex="1" parent="col_0">
          <mxGeometry x="20" y="60" width="285" height="150" as="geometry" />
        </mxCell>
        <mxCell id="col_1" value="Provider host implementation" style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;resizeChildren=0;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fillColor=#F5F7FA;strokeColor=#BDCBD6;fontColor=#20384A;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="150" width="325" height="520" as="geometry" />
        </mxCell>
        <mxCell id="agent" value="&lt;b&gt;[B] OpenCodeAgent : BaseAgent&lt;/b&gt;&lt;br/&gt;opencode/agent.py&lt;br/&gt;&lt;br/&gt;Require an injected transport, bind attempts and coordinate final snapshots/evidence. Deployment wiring remains incomplete." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#F0EAF8;strokeColor=#8193A5;fontColor=#20384A;fontSize=14;" vertex="1" parent="col_1">
          <mxGeometry x="20" y="60" width="285" height="150" as="geometry" />
        </mxCell>
        <mxCell id="runtime" value="&lt;b&gt;[C] IsolatedOpenCode&lt;/b&gt;&lt;br/&gt;opencode/boundary.py; models.py&lt;br/&gt;&lt;br/&gt;Own controller setup, shared ACP session, native model selection, cancellation and exact resource closure." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#F0EAF8;strokeColor=#8193A5;fontColor=#20384A;fontSize=14;" vertex="1" parent="col_1">
          <mxGeometry x="20" y="290" width="285" height="150" as="geometry" />
        </mxCell>
        <mxCell id="col_2" value="Shared host adapters" style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;resizeChildren=0;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fillColor=#F5F7FA;strokeColor=#BDCBD6;fontColor=#20384A;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="915" y="150" width="325" height="520" as="geometry" />
        </mxCell>
        <mxCell id="acp" value="&lt;b&gt;[D] Shared ACP bridge + Python SDK&lt;/b&gt;&lt;br/&gt;agents/agents/base/acp/session.py; transport.py&lt;br/&gt;&lt;br/&gt;AcpSession composes the upstream ACP SDK. DockerTransport carries its frames over attached stdin/stdout." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#EAF0FA;strokeColor=#8193A5;fontColor=#20384A;fontSize=14;" vertex="1" parent="col_2">
          <mxGeometry x="20" y="60" width="285" height="150" as="geometry" />
        </mxCell>
        <mxCell id="docker" value="&lt;b&gt;[E] Shared Docker mechanics&lt;/b&gt;&lt;br/&gt;py-docker -&amp;gt; Docker SDK -&amp;gt; Engine&lt;br/&gt;&lt;br/&gt;Create/attach owned containers, execute jobs, retain receipts and reconcile cleanup." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#E7F3EC;strokeColor=#8193A5;fontColor=#20384A;fontSize=14;" vertex="1" parent="col_2">
          <mxGeometry x="20" y="290" width="285" height="150" as="geometry" />
