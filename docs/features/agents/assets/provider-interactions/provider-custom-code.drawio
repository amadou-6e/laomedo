        <mxCell id="cli" value="&lt;b&gt;[A] Native OpenCode ACP + Agent&lt;/b&gt;&lt;br/&gt;opencode acp&lt;br/&gt;&lt;br/&gt;One upstream process supplies both ACP and native execution. No custom in-container ACP adapter." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#E7F3EC;strokeColor=#8193A5;fontColor=#20384A;fontSize=14;" vertex="1" parent="col_0">
          <mxGeometry x="20" y="60" width="285" height="150" as="geometry" />
        </mxCell>
        <mxCell id="db" value="&lt;b&gt;[B] Native session database&lt;/b&gt;&lt;br/&gt;Persistent mounted sessions/&lt;br/&gt;&lt;br/&gt;OpenCode writes native messages and session relations; history export reads a consistent bound tree." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#E7F3EC;strokeColor=#8193A5;fontColor=#20384A;fontSize=14;" vertex="1" parent="col_0">
          <mxGeometry x="20" y="290" width="285" height="150" as="geometry" />
