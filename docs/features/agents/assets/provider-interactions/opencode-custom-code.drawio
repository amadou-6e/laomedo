        </mxCell>
        <mxCell id="profile" value="&lt;b&gt;Restricted view + profile mounts&lt;/b&gt;&lt;br/&gt;Private generated config / auth / sessions&lt;br/&gt;&lt;br/&gt;Only admitted skills/config and read-only auth reach the controller. Model-writable project config stays out." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#E7F3EC;strokeColor=#8193A5;fontColor=#20384A;fontSize=14;" vertex="1" parent="col_2">
