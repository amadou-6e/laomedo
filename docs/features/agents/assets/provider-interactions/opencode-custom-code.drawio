        </mxCell>
        <mxCell id="activity" value="&lt;b&gt;Shared Activity store / projection&lt;/b&gt;&lt;br/&gt;agents/activity/&lt;br/&gt;&lt;br/&gt;Persist and present retained observations. Provider history/projection supplies native identity, child usage and cost facts." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#EAF0FA;strokeColor=#8193A5;fontColor=#20384A;fontSize=14;" vertex="1" parent="col_3">
