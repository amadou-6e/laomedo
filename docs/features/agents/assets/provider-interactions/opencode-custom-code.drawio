        <mxCell id="source" value="&lt;b&gt;Existing Console account&lt;/b&gt;&lt;br/&gt;Host-owned account source&lt;br/&gt;&lt;br/&gt;Host setup selects approved access/routing data; no full profile or refresh ownership transfer." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#E7F3EC;strokeColor=#8193A5;fontColor=#20384A;fontSize=14;" vertex="1" parent="col_0">
