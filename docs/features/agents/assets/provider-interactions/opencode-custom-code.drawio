        </mxCell>
        <mxCell id="auth" value="&lt;b&gt;Native auth adaptation&lt;/b&gt;&lt;br/&gt;opencode/auth/; utils.py&lt;br/&gt;&lt;br/&gt;Host setup selects Console credential/routing. Runtime checks expiry and keyed credential binding." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#F0EAF8;strokeColor=#8193A5;fontColor=#20384A;fontSize=14;" vertex="1" parent="col_1">
          <mxGeometry x="20" y="60" width="285" height="150" as="geometry" />
