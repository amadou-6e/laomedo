        <mxCell id="broker" value="&lt;b&gt;Host CommandBroker&lt;/b&gt;&lt;br/&gt;opencode/boundary.py; http/&lt;br/&gt;&lt;br/&gt;Authenticated remote MCP receives native tool calls and admits credential-free Docker command jobs." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#F0EAF8;strokeColor=#8193A5;fontColor=#20384A;fontSize=14;" vertex="1" parent="col_1">
