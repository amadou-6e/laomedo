        <mxCell id="agent" value="&lt;b&gt;OpenCodeAgent : BaseAgent&lt;/b&gt;&lt;br/&gt;opencode/agent.py&lt;br/&gt;&lt;br/&gt;Require an injected transport, bind attempts and coordinate final snapshots/evidence. Deployment wiring remains incomplete." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#F0EAF8;strokeColor=#8193A5;fontColor=#20384A;fontSize=14;" vertex="1" parent="col_1">
