        <mxCell id="col_0" value="Native sources" style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;resizeChildren=0;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fillColor=#F5F7FA;strokeColor=#BDCBD6;fontColor=#20384A;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="45" y="150" width="325" height="520" as="geometry" />
        </mxCell>
        <mxCell id="cli" value="&lt;b&gt;[A] Native OpenCode ACP + Agent&lt;/b&gt;&lt;br/&gt;opencode acp&lt;br/&gt;&lt;br/&gt;One upstream process supplies both ACP and native execution. No custom in-container ACP adapter." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#E7F3EC;strokeColor=#8193A5;fontColor=#20384A;fontSize=14;" vertex="1" parent="col_0">
          <mxGeometry x="20" y="60" width="285" height="150" as="geometry" />
        </mxCell>
        <mxCell id="db" value="&lt;b&gt;[B] Native session database&lt;/b&gt;&lt;br/&gt;Persistent mounted sessions/&lt;br/&gt;&lt;br/&gt;OpenCode writes native messages and session relations; history export reads a consistent bound tree." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#E7F3EC;strokeColor=#8193A5;fontColor=#20384A;fontSize=14;" vertex="1" parent="col_0">
          <mxGeometry x="20" y="290" width="285" height="150" as="geometry" />
        </mxCell>
        <mxCell id="col_1" value="Shared capture / provider history" style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;resizeChildren=0;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fillColor=#F5F7FA;strokeColor=#BDCBD6;fontColor=#20384A;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="150" width="325" height="520" as="geometry" />
        </mxCell>
        <mxCell id="capture" value="&lt;b&gt;[C] Shared AcpCapture&lt;/b&gt;&lt;br/&gt;agents/activity/acp/capture.py&lt;br/&gt;&lt;br/&gt;Retain bound live updates and reconcile offline native records. Completeness is a separate observation." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#EAF0FA;strokeColor=#8193A5;fontColor=#20384A;fontSize=14;" vertex="1" parent="col_1">
          <mxGeometry x="20" y="60" width="285" height="150" as="geometry" />
        </mxCell>
        <mxCell id="reader" value="&lt;b&gt;[D] HistoryReader&lt;/b&gt;&lt;br/&gt;opencode/history/reader.py&lt;br/&gt;&lt;br/&gt;After closure, export consistent native session trees without the live credential store." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#F0EAF8;strokeColor=#8193A5;fontColor=#20384A;fontSize=14;" vertex="1" parent="col_1">
          <mxGeometry x="20" y="290" width="285" height="150" as="geometry" />
        </mxCell>
        <mxCell id="col_2" value="Provider interpretation" style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;resizeChildren=0;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fillColor=#F5F7FA;strokeColor=#BDCBD6;fontColor=#20384A;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="915" y="150" width="325" height="520" as="geometry" />
        </mxCell>
        <mxCell id="projection" value="&lt;b&gt;[E] OpenCode Activity projection&lt;/b&gt;&lt;br/&gt;opencode/activity/projection.py&lt;br/&gt;&lt;br/&gt;Interpret native usage, child identity and costs; preserve missing observations." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#F0EAF8;strokeColor=#8193A5;fontColor=#20384A;fontSize=14;" vertex="1" parent="col_2">
