        </mxCell>
        <mxCell id="runtime" value="&lt;b&gt;[C] IsolatedOpenCode&lt;/b&gt;&lt;br/&gt;opencode/boundary.py; models.py&lt;br/&gt;&lt;br/&gt;Own controller setup, shared ACP session, native model selection, cancellation and exact resource closure." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#F0EAF8;strokeColor=#8193A5;fontColor=#20384A;fontSize=14;" vertex="1" parent="col_1">
          <mxGeometry x="20" y="290" width="285" height="150" as="geometry" />
