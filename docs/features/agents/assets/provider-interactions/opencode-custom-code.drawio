  <diagram id="opencode-tools-auth" name="2. Tools and credentials">
    <mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="2560" pageHeight="945">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="diagram-title" value="OpenCode | 2. Tools and credentials" vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=24;fontColor=#20384A;">
          <mxGeometry x="60" y="25" width="1680" height="45" as="geometry" />
        </mxCell>
        <mxCell id="diagram-note" value="Credential path across the top; command requests return through host admission to a separate worker. | Current runtime 19c7f1f. Paths are repository/package-relative as shown." vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=12;fontColor=#9A6949;">
          <mxGeometry x="60" y="78" width="1680" height="45" as="geometry" />
        </mxCell>
        <mxCell id="col_0" value="Host source / shared Docker" style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;resizeChildren=0;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fillColor=#F5F7FA;strokeColor=#BDCBD6;fontColor=#20384A;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="45" y="150" width="325" height="520" as="geometry" />
        </mxCell>
        <mxCell id="source" value="&lt;b&gt;[A] Existing Console account&lt;/b&gt;&lt;br/&gt;Host-owned account source&lt;br/&gt;&lt;br/&gt;Host setup selects approved access/routing data; no full profile or refresh ownership transfer." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#E7F3EC;strokeColor=#8193A5;fontColor=#20384A;fontSize=14;" vertex="1" parent="col_0">
          <mxGeometry x="20" y="60" width="285" height="150" as="geometry" />
        </mxCell>
        <mxCell id="docker" value="&lt;b&gt;[B] Shared Docker mechanics&lt;/b&gt;&lt;br/&gt;py-docker -&amp;gt; Docker SDK -&amp;gt; Engine&lt;br/&gt;&lt;br/&gt;Create/attach owned containers, execute jobs, retain receipts and reconcile cleanup." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#E7F3EC;strokeColor=#8193A5;fontColor=#20384A;fontSize=14;" vertex="1" parent="col_0">
          <mxGeometry x="20" y="290" width="285" height="150" as="geometry" />
        </mxCell>
        <mxCell id="col_1" value="Provider host adapters" style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;resizeChildren=0;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fillColor=#F5F7FA;strokeColor=#BDCBD6;fontColor=#20384A;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="150" width="325" height="520" as="geometry" />
        </mxCell>
        <mxCell id="auth" value="&lt;b&gt;[C] Native auth adaptation&lt;/b&gt;&lt;br/&gt;opencode/auth/; utils.py&lt;br/&gt;&lt;br/&gt;Host setup selects Console credential/routing. Runtime checks expiry and keyed credential binding." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#F0EAF8;strokeColor=#8193A5;fontColor=#20384A;fontSize=14;" vertex="1" parent="col_1">
          <mxGeometry x="20" y="60" width="285" height="150" as="geometry" />
        </mxCell>
        <mxCell id="broker" value="&lt;b&gt;[D] Host CommandBroker&lt;/b&gt;&lt;br/&gt;opencode/boundary.py; http/&lt;br/&gt;&lt;br/&gt;Authenticated remote MCP receives native tool calls and admits credential-free Docker command jobs." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#F0EAF8;strokeColor=#8193A5;fontColor=#20384A;fontSize=14;" vertex="1" parent="col_1">
          <mxGeometry x="20" y="290" width="285" height="150" as="geometry" />
        </mxCell>
        <mxCell id="col_2" value="Controller state / tools" style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;resizeChildren=0;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fillColor=#F5F7FA;strokeColor=#BDCBD6;fontColor=#20384A;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="915" y="150" width="325" height="520" as="geometry" />
        </mxCell>
        <mxCell id="profile" value="&lt;b&gt;[E] Restricted view + profile mounts&lt;/b&gt;&lt;br/&gt;Private generated config / auth / sessions&lt;br/&gt;&lt;br/&gt;Only admitted skills/config and read-only auth reach the controller. Model-writable project config stays out." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#E7F3EC;strokeColor=#8193A5;fontColor=#20384A;fontSize=14;" vertex="1" parent="col_2">
          <mxGeometry x="20" y="60" width="285" height="150" as="geometry" />
        </mxCell>
        <mxCell id="bridge" value="&lt;b&gt;[F] Native remote MCP client&lt;/b&gt;&lt;br/&gt;Part of the opencode process&lt;br/&gt;&lt;br/&gt;Calls host /mcp directly; this is not another custom adapter." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#E7F3EC;strokeColor=#8193A5;fontColor=#20384A;fontSize=14;" vertex="1" parent="col_2">
          <mxGeometry x="20" y="290" width="285" height="150" as="geometry" />
        </mxCell>
        <mxCell id="col_3" value="Controller / separate worker" style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;resizeChildren=0;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fillColor=#F5F7FA;strokeColor=#BDCBD6;fontColor=#20384A;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1350" y="150" width="325" height="520" as="geometry" />
        </mxCell>
        <mxCell id="cli" value="&lt;b&gt;[G] Native OpenCode ACP + Agent&lt;/b&gt;&lt;br/&gt;opencode acp&lt;br/&gt;&lt;br/&gt;One upstream process supplies both ACP and native execution. No custom in-container ACP adapter." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#E7F3EC;strokeColor=#8193A5;fontColor=#20384A;fontSize=14;" vertex="1" parent="col_3">
          <mxGeometry x="20" y="60" width="285" height="150" as="geometry" />
        </mxCell>
        <mxCell id="worker" value="&lt;b&gt;[H] Credential-free command worker&lt;/b&gt;&lt;br/&gt;Separate Docker container&lt;br/&gt;&lt;br/&gt;No network or credential mount. Current image comes from Codex; neutral packaging is still needed." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#E7F3EC;strokeColor=#8193A5;fontColor=#20384A;fontSize=14;" vertex="1" parent="col_3">
