+      const mime = {'.html': 'text/html', '.js': 'application/javascript', '.css': 'text/css', '.svg': 'image/svg+xml', '.json': 'application/json'};
+      return route.fulfill({path: file, contentType: mime[extension] || 'application/octet-stream'});
