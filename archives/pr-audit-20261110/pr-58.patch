+                report["probe_end_ns"] = time.time_ns()
+                try:
+                    report["probe"] = json.loads(run.stdout.strip().splitlines()[-1])
+                except (ValueError, IndexError):
+                    report["probe"] = {"parse_error": True, "stderr_class": "probe_failed"}
+                docker("stop", "--time", "1", names["stage"])
