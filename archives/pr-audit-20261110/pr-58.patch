+                 "canonical_skill", "host", "runner_store", "credential_standin")}
+        for path in roots.values():
+            path.mkdir()
+            (path / "canary.txt").write_text(secrets.token_hex(12), encoding="utf-8")
+        report["root_errors"] = validate_host_roots(roots)
