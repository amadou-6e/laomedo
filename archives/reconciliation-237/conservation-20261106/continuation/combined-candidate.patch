+                "model": model,
+                "effort": effort,
+                "request_id": selected_request_id,
+            }
+            if len(refs) == 1:
+                payload["skill_ref"] = {
+                    key: refs[0][key]
+                    for key in ("skill_id", "revision_id", "tree_hash")
+                }
+            else:
