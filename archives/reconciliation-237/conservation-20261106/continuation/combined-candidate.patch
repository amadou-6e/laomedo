-    summary["observed_tool_results"] = sum(
-        tool.get("status") == "completed" for tool in latest.get("tools", [])
-    )
-    opencode._json(STATE / (phase + "-flow-summary.json"), summary)
-    if phase == "fresh" and latest["status"] == "completed":
-        opencode._json(
