@@ -0,0 +1,61 @@
+import { act, fireEvent, render, renderHook, screen } from "@testing-library/react";
+import SkillNavigation, { useSkillNavigation } from "./SkillNavigation";
+
+function NavigationExample() {
+  const state = useSkillNavigation("skill:revision", ["SKILL.md", "references/nested/rules.md"]);
+  return <>
+    <button onClick={state.toggleAll}>{state.allOpen ? "Collapse all" : "Open all"}</button>
+    <SkillNavigation open={state.open} onToggle={state.toggleSection}
+      files={<input aria-label="Selected file" defaultValue="SKILL.md" />} commits={<p>Selected commit</p>} />
+  </>;
+}
+
+test("individual chevrons preserve selected content without redundant section menus", () => {
+  render(<NavigationExample />);
+  expect(screen.queryByLabelText("Files actions")).not.toBeInTheDocument();
+  expect(screen.queryByLabelText("Commits actions")).not.toBeInTheDocument();
+  const file = screen.getByRole("textbox", { name: "Selected file" });
+  fireEvent.change(file, { target: { value: "references/nested/rules.md" } });
+  fireEvent.click(screen.getByRole("button", { name: "Files" }));
+  expect(file).not.toBeVisible();
+  expect(screen.getByText("Selected commit")).toBeVisible();
+  fireEvent.click(screen.getByRole("button", { name: "Open all" }));
+  expect(file).toBeVisible();
+  expect(file).toHaveValue("references/nested/rules.md");
+  fireEvent.click(screen.getByRole("button", { name: "Collapse all" }));
+  expect(file).not.toBeVisible();
+  expect(screen.getByText("Selected commit")).not.toBeVisible();
+  fireEvent.click(screen.getByRole("button", { name: "Open all" }));
+  expect(file).toHaveValue("references/nested/rules.md");
+});
+
+test("bulk action includes nested folders and resolves a mixed state to open all", () => {
+  const { result } = renderHook(() => useSkillNavigation("skill:revision", ["SKILL.md", "references/nested/rules.md"]));
+  act(() => result.current.showFind());
+  act(() => result.current.toggleFolder("references/nested"));
+  expect(result.current.allOpen).toBe(false);
+  act(() => result.current.toggleAll());
+  expect(result.current.collapsedFolders.size).toBe(0);
+  expect(result.current.allOpen).toBe(true);
+  act(() => result.current.toggleAll());
+  expect(result.current.open).toEqual({ Find: false, Files: false, Commits: false });
+  expect([...result.current.collapsedFolders]).toEqual(["references", "references/nested",
+    "search:folder:references", "search:folder:references/nested", "search:file:SKILL.md", "search:file:references/nested/rules.md"]);
+  act(() => result.current.toggleSection("Files"));
+  expect(result.current.allOpen).toBe(false);
+  act(() => result.current.toggleAll());
+  expect(result.current.allOpen).toBe(true);
+});
+
+test("no-folder skills use section state, ignore stale historical folders, and reset on identity changes", () => {
+  const { result, rerender } = renderHook(({ identity, paths }) => useSkillNavigation(identity, paths), { initialProps: { identity: "one", paths: ["SKILL.md", "old/rules.md"] } });
+  act(() => result.current.showFind());
+  act(() => result.current.toggleFolder("old"));
+  rerender({ identity: "one", paths: ["SKILL.md"] });
+  expect(result.current.allOpen).toBe(true);
+  act(() => result.current.toggleAll());
+  expect(result.current.allOpen).toBe(false);
+  rerender({ identity: "two", paths: ["SKILL.md"] });
+  expect(result.current.allOpen).toBe(false);
+  expect(result.current.open.Find).toBe(false);
+});
diff --git a/frontend/langflow-skill-viewer/skills/workspace/SkillNavigation.tsx b/frontend/langflow-skill-viewer/skills/workspace/SkillNavigation.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..4b993bc922fa0d7773b5cf1b39f1980e0c468b33
--- /dev/null
+++ b/frontend/langflow-skill-viewer/skills/workspace/SkillNavigation.tsx
@@ -0,0 +1,44 @@
+import { SkillChevron } from "../explorer/SkillIcons";
+import { useEffect, useState, type ReactNode } from "react";
+
+export function useSkillNavigation(identity: string, paths: string[], directories: string[] = []) {
+  const [open, setOpen] = useState({ Find: false, Files: true, Commits: true });
+  const [collapsedFolders, setCollapsedFolders] = useState<Set<string>>(new Set());
+  const fileFolders = [...new Set([...directories, ...paths.flatMap((path) => {
+    const parts = path.split("/");
+    return parts.slice(0, -1).map((_, index) => parts.slice(0, index + 1).join("/"));
+  })])];
+  const folders = [...fileFolders, ...fileFolders.map((path) => `search:folder:${path}`), ...paths.map((path) => `search:file:${path}`)];
+  useEffect(() => { setOpen({ Find: false, Files: true, Commits: true }); setCollapsedFolders(new Set()); }, [identity]);
+  const allOpen = open.Find && open.Files && open.Commits && folders.every((path) => !collapsedFolders.has(path));
+  return {
+    open, collapsedFolders, allOpen,
+    showFind: () => setOpen((current) => ({ ...current, Find: true })),
+    hideFind: () => setOpen((current) => ({ ...current, Find: false })),
+    toggleSection: (name: keyof typeof open) => setOpen((current) => ({ ...current, [name]: !current[name] })),
+    toggleFolder: (path: string) => setCollapsedFolders((current) => {
+      const next = new Set(current); if (next.has(path)) next.delete(path); else next.add(path); return next;
+    }),
+    toggleAll: () => { setOpen({ Find: !allOpen, Files: !allOpen, Commits: !allOpen }); setCollapsedFolders(new Set(allOpen ? folders : [])); },
+  };
+}
+
+export default function SkillNavigation({ files, commits, find, open, onToggle }: {
+  files: ReactNode; commits: ReactNode; find?: ReactNode; open: { Find?: boolean; Files: boolean; Commits: boolean };
+  onToggle: (name: "Find" | "Files" | "Commits") => void;
+}) {
+  return <div role="group" className="flex min-h-0 flex-1 flex-col" aria-label="Skill navigation sections">
+    {([...(find ? [['Find', find] as const] : []), ['Files', files], ['Commits', commits]] as const).map(([name, body]) => <section key={name}
+      className={`relative flex min-h-0 flex-col border-b ${open[name] ? 'flex-1' : 'shrink-0'}`}>
+      <div className="flex h-8 shrink-0 items-center bg-muted/50">
+        <button id={`skill-${name}-toggle`} type="button" aria-expanded={open[name]} aria-controls={`skill-${name}-body`}
+          className="flex min-w-0 flex-1 items-center gap-1 px-1 py-1 text-left text-xs font-semibold uppercase tracking-wide focus-visible:outline focus-visible:-outline-offset-2"
+          onClick={() => onToggle(name)}>
+          <SkillChevron expanded={!!open[name]} />{name}
+        </button>
+      </div>
+      <div id={`skill-${name}-body`} hidden={!open[name]} style={{ display: open[name] ? 'flex' : 'none' }}
+        className="min-h-0 flex-1 flex-col overflow-auto">{body}</div>
+    </section>)}
+  </div>;
+}
