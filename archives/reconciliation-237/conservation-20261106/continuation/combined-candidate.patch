+      width: 285
+      height: 150
+      fill: "#F0EAF8"
+      stroke: "#8193A5"
+      font_size: 14
+      rounded: true
+    source_files: ["src/laomedo/agents/agents/opencode/agent.py"]
+    graph_reference: "B"
+  runtime:
+    label_html: "<b>[C] Controller lifecycle</b><br/>IsolatedOpenCode<br/>opencode/boundary.py; models.py<br/><br/>Own controller setup, shared ACP session, native model selection, cancellation and exact resource closure."
+    style:
+      width: 285
+      height: 150
+      fill: "#F0EAF8"
+      stroke: "#8193A5"
+      font_size: 14
+      rounded: true
+    source_files: ["src/laomedo/agents/agents/opencode/boundary.py", "src/laomedo/agents/agents/opencode/models.py"]
+    graph_reference: "C"
+  acp:
+    label_html: "<b>[D] ACP communication</b><br/>agents/agents/base/acp/session.py; transport.py<br/><br/>AcpSession composes the upstream ACP SDK. DockerTransport carries its frames over attached stdin/stdout."
+    style:
+      width: 285
+      height: 150
+      fill: "#EAF0FA"
+      stroke: "#8193A5"
+      font_size: 14
+      rounded: true
+    source_files: ["src/laomedo/agents/agents/base/acp/session.py", "src/laomedo/agents/agents/base/acp/transport.py"]
+    graph_reference: "D"
+  docker:
+    label_html: "<b>[E] Docker lifecycle</b><br/>py-docker -&gt; Docker SDK -&gt; Engine<br/><br/>Create/attach owned containers, execute jobs, retain receipts and reconcile cleanup."
+    style:
+      width: 285
+      height: 150
+      fill: "#E7F3EC"
+      stroke: "#8193A5"
+      font_size: 14
+      rounded: true
+    source_files: []
+    graph_reference: "E"
+    external_source: "Separate dependencies: py-docker -> Docker SDK -> Docker Engine."
+  adapter:
+    label_html: "<b>[F] ACP endpoint</b><br/>opencode acp<br/><br/>Part of the same native OpenCode process; no custom in-container adapter."
+    style:
+      width: 285
+      height: 150
+      fill: "#E7F3EC"
+      stroke: "#8193A5"
+      font_size: 14
+      rounded: true
+    source_files: []
+    graph_reference: "F"
+    external_source: "Native opencode ACP implementation; no custom adapter files."
+  cli:
+    label_html: "<b>[G] Native agent runtime</b><br/>opencode acp<br/><br/>One upstream process supplies both ACP and native execution. No custom in-container ACP adapter."
+    style:
+      width: 285
+      height: 150
+      fill: "#E7F3EC"
+      stroke: "#8193A5"
+      font_size: 14
+      rounded: true
+    source_files: []
+    graph_reference: "G"
+    external_source: "Upstream native opencode runtime installed in its Docker image."
+  model:
+    label_html: "<b>[H] Model service</b><br/>Outside local Docker<br/><br/>Native OpenCode performs authenticated model requests."
+    style:
+      width: 285
+      height: 150
+      fill: "#E7F3EC"
+      stroke: "#8193A5"
+      font_size: 14
+      rounded: true
+    source_files: []
+    graph_reference: "H"
+    external_source: "External model API; no repository source for the service."
