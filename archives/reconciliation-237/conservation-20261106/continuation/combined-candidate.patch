+    title: "Docker controller"
+    layout: "column"
+    children: ["adapter", "cli"]
+    gap: 80
+    style:
+      padding: [60, 20, 25, 20]
+      min_height: 520
+      fill: "#F5F7FA"
+      font_size: 15
+  col_4:
+    title: "External model"
+    layout: "column"
+    children: ["model"]
+    gap: 80
+    style:
+      padding: [60, 20, 25, 20]
+      min_height: 520
+      fill: "#F5F7FA"
+      font_size: 15
