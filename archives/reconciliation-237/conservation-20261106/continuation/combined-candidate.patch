diff --git a/docker/codex-acp/Dockerfile b/docker/codex-acp/Dockerfile
new file mode 100644
index 0000000000000000000000000000000000000000..9e02ec94b59e4dd477b44f40067f36c7e42e6c9a
--- /dev/null
+++ b/docker/codex-acp/Dockerfile
@@ -0,0 +1,36 @@
+FROM node:22-bookworm-slim@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d AS adapter
+RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates \
+    && rm -rf /var/lib/apt/lists/*
+ADD https://codeload.github.com/agentclientprotocol/codex-acp/tar.gz/68d7d2d5ddfc0ed5746f9f6130892dda685e65dd /tmp/adapter.tar.gz
+RUN echo "51ba8d1d302f8a854c0501887ffbe12fb267f6e8fdae9ad2b58e2c8fc9513b1e  /tmp/adapter.tar.gz" | sha256sum -c - \
+    && mkdir /source && tar -xzf /tmp/adapter.tar.gz -C /source --strip-components=1
+WORKDIR /source
+RUN npm ci --ignore-scripts --no-audit --no-fund
+COPY native-events.patch /tmp/native-events.patch
+COPY LaomedoExtension.ts src/LaomedoExtension.ts
+COPY LaomedoExtension.test.ts src/LaomedoExtension.test.ts
+COPY LaomedoLaunch.ts src/LaomedoLaunch.ts
+COPY LaomedoLaunch.test.ts src/LaomedoLaunch.test.ts
+RUN git apply /tmp/native-events.patch && npm run typecheck \
+    && npx vitest run src/LaomedoExtension.test.ts src/LaomedoLaunch.test.ts --no-file-parallelism && npm run build \
+    && sha256sum /tmp/native-events.patch src/LaomedoExtension.ts src/LaomedoLaunch.ts dist/index.js > /tmp/adapter-checksums.txt
+
+FROM node:22-bookworm-slim@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d
+RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git python3 ripgrep \
+    && rm -rf /var/lib/apt/lists/* \
+    && groupadd --gid 10001 runner && useradd --uid 10001 --gid 10001 --create-home runner \
+    && mkdir /draft /opt/acp && chown runner:runner /draft
+COPY package.json package-lock.json /opt/codex/
+RUN npm ci --prefix /opt/codex --omit=dev --ignore-scripts --no-audit --no-fund \
+    && ln -s /opt/codex/node_modules/.bin/codex /usr/local/bin/codex \
+    && test "$(codex --version)" = "codex-cli 0.159.2"
+COPY --from=adapter /source/dist/index.js /opt/acp/index.mjs
+COPY --from=adapter /source/LICENSE /opt/acp/LICENSE
+COPY --from=adapter /tmp/adapter-checksums.txt /opt/acp/adapter-checksums.txt
+LABEL org.opencontainers.image.source="https://github.com/agentclientprotocol/codex-acp" \
+    org.opencontainers.image.revision="68d7d2d5ddfc0ed5746f9f6130892dda685e65dd" \
+    org.opencontainers.image.licenses="Apache-2.0"
+USER runner
+ENV HOME=/home/runner CODEX_PATH=/usr/local/bin/codex LAOMEDO_CODEX_NATIVE_EVENTS=1
+WORKDIR /draft
+CMD ["node", "/opt/acp/index.mjs"]
diff --git a/docker/codex-acp/LaomedoExtension.test.ts b/docker/codex-acp/LaomedoExtension.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8969bfd96c0167fb66165e1f2c9086ff5d5f7b60
--- /dev/null
+++ b/docker/codex-acp/LaomedoExtension.test.ts
@@ -0,0 +1,78 @@
+/** Internal adapter controls. No provider, credentials or model turn is used. */
+import {describe, it, expect, vi} from "vitest";
+import type * as acp from "@agentclientprotocol/sdk";
+import type {MessageConnection} from "vscode-jsonrpc/node";
+import type {CodexAppServerClient} from "./CodexAppServerClient";
+import {LaomedoExtension, probeParams, executorParams} from "./LaomedoExtension";
+
+function setup() {
+    let observe: (event: any) => void = () => {};
+    const native = {onRequest: vi.fn(), sendRequest: vi.fn().mockResolvedValue({})};
+    const host = {notify: vi.fn().mockResolvedValue(undefined), request: vi.fn().mockResolvedValue({success: true})};
+    const terminate = vi.fn();
+    const extension = new LaomedoExtension({onClientTransportEvent: (fn: any) => {observe = fn;}} as unknown as CodexAppServerClient,
+        native as unknown as MessageConnection, host as unknown as acp.AgentContext, terminate);
+    const request = {cwd: "/draft", mcpServers: [], _meta: {laomedo: {policy: "normal", model: "observed-model", effort: "low"}}} as acp.NewSessionRequest;
+    return {extension, native, host, terminate, request, observe: (method: string, params: any) => observe({eventType:"notification", method, params})};
+}
+
+describe("Laomedo ACP policy", () => {
+    it("advertises the versioned raw-event and host-policy contract", () => {
+        expect(LaomedoExtension.capabilities).toEqual({version: 1, rawEvents: true, hostPolicy: true});
+    });
+    it("inherits the normal permission profile without agent-mode overrides", () => {
+        const {extension, request} = setup();
+        const params = extension.sessionParameters(request);
+        extension.bind(request, "native-session");
+        expect(params.approvalPolicy).toBe("never");
+        const turn = extension.turnParameters({sessionId:"native-session", prompt:[]});
+        expect(turn).toEqual({input:[]});
+        extension.assertSelection("native-session", "observed-model", "low");
+        expect(() => extension.assertSelection("native-session", "other", "low")).toThrow();
+    });
+
+    it("rejects missing/unknown policy, unregistered split selection and arbitrary commands", () => {
+        const {extension, request} = setup();
+        expect(() => extension.sessionParameters({...request, _meta:{}})).toThrow();
+        expect(() => extension.sessionParameters({...request, _meta:{laomedo:{policy:"agent-full-access"}}})).toThrow();
+        expect(() => extension.sessionParameters({...request, _meta:{laomedo:{policy:"split",model:"m",effort:"low",environmentId:"unregistered"}}})).toThrow();
+        expect(() => probeParams.parse({check:"auth_read", command:["cat", "/anything"]})).toThrow();
+        expect(() => executorParams.parse({environmentId:"e",execServerUrl:"ws://remote:39871",authBearerToken:"x".repeat(32),connectTimeoutMs:15000})).toThrow();
+    });
+
+    it("preserves native completion before returning and excludes unrelated child completion", async () => {
+        const {extension, host, observe, terminate} = setup();
+        let release: () => void = () => {};
+        host.notify.mockImplementationOnce(() => new Promise<void>(resolve => {release = resolve;}));
+        let returned = false;
+        const pending = extension.prompt("root", async () => {
+            observe("turn/completed", {threadId:"root", turn:{id:"turn",status:"completed"}});
+            return "result";
+        }).then(value => {returned = true; return value;});
+        await Promise.resolve(); await Promise.resolve();
+        expect(returned).toBe(false);
+        release();
+        expect(await pending).toBe("result");
+        expect(terminate).not.toHaveBeenCalled();
+        await expect(extension.prompt("root", async () => {
+            observe("turn/completed", {threadId:"child",turn:{id:"child-turn",status:"completed"}});
+        })).rejects.toThrow();
+        expect(terminate).toHaveBeenCalled();
+    });
+
+    it("never forwards account/auth/config or executor capability records", async () => {
+        const {extension, host, observe} = setup();
+        for (const method of ["account/updated", "config/updated", "environment/status"]) {
+            observe(method, {private:"never forward"});
+        }
+        await expect(extension.prompt("root", async () => {})).rejects.toThrow();
+        expect(host.notify).not.toHaveBeenCalled();
+    });
+
+    it("closes registration and preflight once a prompt starts", async () => {
+        const {extension} = setup();
+        await expect(extension.prompt("root", async () => {})).rejects.toThrow();
+        await expect(extension.preflight({check:"workspace_write"})).rejects.toThrow();
+        await expect(extension.registerExecutor({environmentId:"e",execServerUrl:"ws://127.0.0.1:39871",authBearerToken:"x".repeat(32),connectTimeoutMs:15000})).rejects.toThrow();
+    });
+});
diff --git a/docker/codex-acp/LaomedoExtension.ts b/docker/codex-acp/LaomedoExtension.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8e001b90438861aa82fa08fa40ae902125b9b177
--- /dev/null
+++ b/docker/codex-acp/LaomedoExtension.ts
@@ -0,0 +1,184 @@
+/** Bounded host features absent from ACP v1; never a native RPC tunnel. */
+import * as acp from "@agentclientprotocol/sdk";
+import {z} from "zod";
+import type {MessageConnection} from "vscode-jsonrpc/node";
+import type {CodexAppServerClient} from "./CodexAppServerClient";
+
+const sessionPolicy = z.object({
+    policy: z.enum(["normal", "split"]),
+    model: z.string().min(1).max(200),
+    effort: z.string().min(1).max(40),
+    environmentId: z.string().min(1).max(200).optional(),
+    dynamicTools: z.array(z.object({
+        type: z.literal("function"),
+        name: z.literal("laomedo_output_precheck"),
+        description: z.string().max(65536),
+        inputSchema: z.record(z.string(), z.unknown()),
+    }).strict()).max(1).default([]),
+}).strict();
+
+const promptPolicy = z.object({
+    skills: z.array(z.object({
+        type: z.literal("skill"),
+        name: z.string().regex(/^[A-Za-z0-9_-]+$/),
+        path: z.string().regex(/^\/draft\/\.agents\/skills\/[A-Za-z0-9_-]+\/SKILL\.md$/),
+    }).strict()).max(64).default([]),
+}).strict();
+
+export const emptyParams = z.object({}).strict();
+export const modelParams = z.object({cursor: z.string().nullable().optional()}).strict();
+export const probeParams = z.object({
+    check: z.enum(["workspace_write", "canonical_write", "store_write", "auth_read", "git_binary", "network"]),
+}).strict();
+export const executorParams = z.object({
+    environmentId: z.string().min(1).max(200),
+    execServerUrl: z.literal("ws://127.0.0.1:39871"),
+    authBearerToken: z.string().min(32).max(512),
+    connectTimeoutMs: z.literal(15000),
+}).strict();
+export const statusParams = executorParams.pick({environmentId: true});
+
+export class LaomedoExtension {
+    static readonly capabilities = {version: 1, rawEvents: true, hostPolicy: true};
+    private sessions = new Map<string, z.infer<typeof sessionPolicy>>();
+    private rawQueue: Promise<void> = Promise.resolve();
+    private rawFailed = false;
+    private prompted = false;
+    private executorId?: string;
+    private completed = new Map<string, number>();
+
+    constructor(
+        private app: CodexAppServerClient,
+        private native: MessageConnection,
+        private host: Pick<acp.AgentContext, "notify" | "request">,
+        private terminate: () => void,
+    ) {
+        app.onClientTransportEvent((event) => {
+            if (event.eventType !== "notification") return;
+            const {method, params} = event;
+            if (!(method === "thread/started" || method === "thread/tokenUsage/updated"
+                || method === "turn/started" || method === "turn/completed"
+                || method === "error"
+                || method.startsWith("item/") || method.startsWith("turn/plan/")
+                || method.startsWith("turn/diff/"))) return;
+            this.rawQueue = this.rawQueue.then(async () => {
+                await host.notify("_laomedo/codexEvent", {method, params});
+                if (method === "turn/completed") {
+                    const threadId = (params as {threadId: string}).threadId;
+                    this.completed.set(threadId, (this.completed.get(threadId) ?? 0) + 1);
+                }
+            }).catch(() => {
+                this.rawFailed = true;
+                terminate();
+            });
+        });
+        native.onRequest("item/tool/call", async (params: any) => {
+            const policy = this.sessions.get(params.threadId);
+            if (params.tool !== "laomedo_output_precheck" || params.namespace != null
+                || !policy?.dynamicTools.length) {
+                throw acp.RequestError.methodNotFound("item/tool/call");
+            }
+            // Host is pure contract validation. No filesystem/terminal delegation.
+            return host.request("_laomedo/outputPrecheck", params);
+        });
+    }
+
+    sessionParameters(request: acp.NewSessionRequest | acp.LoadSessionRequest) {
+        const policy = sessionPolicy.parse(request._meta?.["laomedo"]);
+        if (request.cwd !== "/draft" || request.mcpServers.length) {
+            throw acp.RequestError.invalidParams("Invalid Laomedo session scope");
+        }
+        if ((policy.policy === "split") !== Boolean(policy.environmentId)
+            || (policy.environmentId && policy.environmentId !== this.executorId)) {
+            throw acp.RequestError.invalidParams("Executor selection mismatch");
+        }
+        return {
+            model: policy.model,
+            approvalPolicy: "never" as const,
+            ...(policy.dynamicTools.length ? {dynamicTools: policy.dynamicTools} : {}),
+            ...(policy.environmentId ? {environments: [{environmentId: policy.environmentId, cwd: "/draft"}]} : {}),
+        };
+    }
+
+    bind(request: acp.NewSessionRequest | acp.LoadSessionRequest, sessionId: string) {
+        this.sessions.set(sessionId, sessionPolicy.parse(request._meta?.["laomedo"]));
+    }
+
+    turnParameters(request: acp.PromptRequest) {
+        const policy = this.sessions.get(request.sessionId);
+        if (!policy) throw acp.RequestError.invalidParams("Unbound Laomedo session");
+        const input = promptPolicy.parse(request._meta?.["laomedo"] ?? {});
+        if (input.skills.some(skill => skill.path !== `/draft/.agents/skills/${skill.name}/SKILL.md`)) {
+            throw acp.RequestError.invalidParams("Pinned skill path mismatch");
+        }
+        return {
+            input: input.skills,
+            ...(policy.policy === "split" ? {
+                sandboxPolicy: {type: "externalSandbox" as const, networkAccess: "restricted" as const},
+                environments: [{environmentId: policy.environmentId, cwd: "/draft", runtimeWorkspaceRoots: ["/draft"]}],
+            } : {}),
+        };
+    }
+
+    assertSelection(sessionId: string, model: string, effort: string | null) {
+        const policy = this.sessions.get(sessionId);
+        if (!policy || policy.model !== model || policy.effort !== effort) {
+            throw acp.RequestError.invalidParams(undefined, "Host model/effort selection mismatch");
+        }
+    }
+
+    async prompt<T>(sessionId: string, run: () => Promise<T>): Promise<T> {
+        this.prompted = true;
+        const before = this.completed.get(sessionId) ?? 0;
+        try {
+            return await run();
+        } finally {
+            // The response cannot overtake native terminal evidence on stdio.
+            await this.rawQueue;
+            if (this.rawFailed || (this.completed.get(sessionId) ?? 0) === before) {
+                this.terminate();
+                throw acp.RequestError.internalError("Native completion evidence unavailable");
+            }
+        }
+    }
+
+    async models(params: z.infer<typeof modelParams>) {
+        return this.app.listModels({cursor: params.cursor ?? null});
+    }
+
+    async skills() {
+        if (this.prompted) throw acp.RequestError.invalidParams("Discovery already closed");
+        return this.app.listSkills({cwds: ["/draft"], forceReload: true});
+    }
+
+    async preflight(params: z.infer<typeof probeParams>) {
+        if (this.sessions.size || this.prompted) throw acp.RequestError.invalidParams("Preflight already closed");
+        const commands = {
+            workspace_write: ["sh", "-c", "printf CANARY > /draft/canary.txt"],
+            canonical_write: ["sh", "-c", "printf FORBIDDEN > /canonical/sentinel.txt"],
+            store_write: ["sh", "-c", "printf FORBIDDEN > /store/sentinel.txt"],
+            auth_read: ["sh", "-c", "cat /home/runner/.codex/auth.json >/dev/null"],
+            git_binary: ["git", "--version"],
+            network: ["python3", "-c", "import socket; s=socket.socket(); s.settimeout(3); s.connect(('1.1.1.1',443)); print('NETWORK_CONNECTED')"],
+        };
+        return this.native.sendRequest("command/exec", {
+            command: commands[params.check], cwd: "/draft", timeoutMs: 15000,
+        });
+    }
+
+    async registerExecutor(params: z.infer<typeof executorParams>) {
+        if (this.prompted || this.executorId || this.sessions.size) {
+            throw acp.RequestError.invalidParams("Executor registration already closed");
+        }
+        const result = await this.native.sendRequest("environment/add", params);
+        this.executorId = params.environmentId;
+        return result;
+    }
+
+    async executorStatus(params: z.infer<typeof statusParams>) {
+        if (this.prompted || params.environmentId !== this.executorId) {
+            throw acp.RequestError.invalidParams("Executor selection mismatch");
+        }
+        return this.native.sendRequest("environment/status", params);
+    }
+}
