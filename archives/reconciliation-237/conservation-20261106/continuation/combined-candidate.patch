+                    SimpleNamespace(returncode=0, stdout='"user","S-1-5-21-123"'),
+                    SimpleNamespace(returncode=0),
+                ],
+            ) as run,
+        ):
+            self.assertIsNone(_restrict_windows_directory(path))
+        self.assertEqual(
+            run.call_args_list,
+            [
+                call(
