+                env={"DOCKER_HOST": "unix:///selected.sock"},
+                split=SplitPolicy(access_token="private-test-token"),
+            )
+            spec = client.return_value.sessions.open.call_args.args[0].spec
+            self.assertEqual(
+                spec.environment["ACCESS_TOKEN"].get_secret_value(),
