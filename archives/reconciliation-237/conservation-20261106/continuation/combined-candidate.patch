new file mode 100644
index 0000000000000000000000000000000000000000..5f9c3a4c81c3f9ac21b052a0ba4d1fb8cdd6b895
--- /dev/null
+++ b/src/laomedo/host/publication/handoff/README.md
@@ -0,0 +1,11 @@
+# Publication handoff values
+
+`PullRequestPublicationRequest` in `models.py` groups the already admitted head,
+base, title, body, correlation marker and draft flag. `to_payload()` preserves the
+existing private journal and host-mediator contract. It is a creation request,
+so it deliberately has no PR number or reference yet.
+
+`HandoffStore` retains transactions, effect reservation, authorization and
+publication phase transitions. Constructing a request neither sends it nor
+authorizes a write. The marker remains host-generated and travels with the
+request for later reconciliation; ambiguous writes are not automatically repeated.
diff --git a/src/laomedo/host/publication/handoff/models.py b/src/laomedo/host/publication/handoff/models.py
new file mode 100644
index 0000000000000000000000000000000000000000..b85d887a28b8ff268989d8bb0f4fc241ae0027d6
--- /dev/null
+++ b/src/laomedo/host/publication/handoff/models.py
@@ -0,0 +1,28 @@
+"""Host-generated PR creation values, distinct from authorization and effects."""
+
+from typing import Literal
+from pydantic import BaseModel, ConfigDict, Field
+
+
+class PullRequestPublicationRequest(BaseModel):
+    """Admitted draft-PR creation proposal before a PR identity exists."""
+
+    model_config = ConfigDict(
+        strict=True, frozen=True, extra="forbid", hide_input_in_errors=True
+    )
+    head: str = Field(description="Host-authorized source branch.")
+    base: str = Field(description="Host-authorized target branch.")
+    title: str = Field(description="Existing admitted PR title.")
+    body: str = Field(
+        description="Existing admitted body including its host correlation marker."
+    )
+    marker: str = Field(
+        description="Host-generated reconciliation marker, never model authority."
+    )
+    draft: Literal[True] = Field(
+        default=True, description="Publication creates a draft PR for separate review."
+    )
+
+    def to_payload(self) -> dict:
+        """Preserve the six-field private publication journal request."""
+        return self.model_dump()
