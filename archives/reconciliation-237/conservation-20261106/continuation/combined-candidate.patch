+        trusted = (
+            type(sdk_class) is str and SDK_FAILURE_CODES.get(sdk_class) == sdk_code
+        )
+        return cls(
+            stage=stage,
+            code=code if type(code) is str and code in RUNNER_FAILURE_CODES else None,
