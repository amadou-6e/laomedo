+from pydantic import BaseModel, ConfigDict, Field, JsonValue, field_serializer
+from laomedo.agents.artifacts.models import ArtifactReference
+
+
+class HandoffSource(BaseModel):
+    """Source identity only; legacy observational values retain their JSON types."""
+
+    model_config = ConfigDict(
+        strict=True, frozen=True, extra="forbid", hide_input_in_errors=True
+    )
+    provider: JsonValue = Field(
+        description="Source provider observation, not an authority grant."
+    )
+    run_id: JsonValue = Field(
+        description="Source run observation; admission is caller-owned."
+    )
+
+
+class HandoffTarget(BaseModel):
+    """Target provider and optional caller metadata, preserving omitted keys."""
+
+    model_config = ConfigDict(
+        strict=True, frozen=True, extra="forbid", hide_input_in_errors=True
+    )
+    provider: Literal["codex", "claude", "opencode"] = Field(
+        description="Provider admitted by the current handoff contract."
