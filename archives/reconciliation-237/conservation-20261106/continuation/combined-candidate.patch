diff --git a/src/laomedo/agents/agents/opencode/utils.py b/src/laomedo/agents/agents/opencode/utils.py
new file mode 100644
index 0000000000000000000000000000000000000000..f86c8912de1b0df17ebcd1fa17ea649006876642
--- /dev/null
+++ b/src/laomedo/agents/agents/opencode/utils.py
@@ -0,0 +1,89 @@
+"""Prepare isolated OpenCode commands and normalize native messages."""
+
+from __future__ import annotations
+
+from pathlib import Path
+import hashlib
+import hmac
+import json
+import re
+from laomedo.agents.agents.opencode.settings import MIN_TOKEN_REMAINING_MS
+from laomedo.agents.errors import RunnerError
+import secrets
+import time
+
+
+def check_auth_fresh(profile):
+    path = Path(profile) / "auth-validity.json"
+    try:
+        validity = json.loads(path.read_text(encoding="utf-8"))
+    except (OSError, ValueError) as exc:
+        raise RunnerError("opencode_auth_validity_required") from exc
+    if not isinstance(validity, dict):
+        raise RunnerError("opencode_auth_validity_invalid")
+    try:
+        key = json.loads((Path(profile) / "auth.json").read_text(encoding="utf-8"))[
+            "opencode-go"
+        ]["key"]
+    except (OSError, ValueError, KeyError, TypeError) as exc:
+        raise RunnerError("opencode_private_auth_required") from exc
+    if (
+        not isinstance(key, str)
+        or validity.get("credential_sha256") != hashlib.sha256(key.encode()).hexdigest()
+    ):
+        raise RunnerError("opencode_auth_validity_mismatch")
+    mode = validity.get("credential_mode")
+    if mode == "provider_key" and validity.get("expires_at_ms") is None:
+        return
+    expiry = validity.get("expires_at_ms")
+    if (
+        mode != "console_token"
+        or not isinstance(expiry, int)
+        or isinstance(expiry, bool)
+    ):
+        raise RunnerError("opencode_auth_validity_invalid")
+    if expiry <= int(time.time() * 1000) + MIN_TOKEN_REMAINING_MS:
+        raise RunnerError("opencode_console_token_refresh_required")
+
+
+def _credential_binding(profile):
+    path = Path(profile) / "credential-binding-key"
+    try:
+        with path.open("xb") as target:
+            target.write(secrets.token_bytes(32))
+    except FileExistsError:
+        pass
+    binding_key = path.read_bytes()
+    if len(binding_key) != 32:
+        raise RunnerError("opencode_credential_binding_key_invalid")
+    fingerprint = json.loads((Path(profile) / "auth-validity.json").read_text())[
+        "credential_sha256"
+    ]
+    return hmac.new(binding_key, fingerprint.encode(), hashlib.sha256).hexdigest()
+
+
+def model_metadata(text):
+    """Parse native models --verbose records; reject incomplete or conflicting IDs."""
+    decoder = json.JSONDecoder()
+    models = []
+    remaining = text.strip()
+    try:
+        while remaining:
+            identity, separator, remaining = remaining.partition("\n")
+            if not separator or not re.fullmatch(
+                r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.:-]+", identity
+            ):
+                raise ValueError()
+            remaining = remaining.lstrip()
+            metadata, size = decoder.raw_decode(remaining)
+            if metadata.get("providerID") + "/" + metadata.get("id") != identity:
+                raise ValueError()
+            models.append(
+                {"id": identity, "efforts": ["default"], "metadata": metadata}
+            )
+            remaining = remaining[size:].strip()
+    except (ValueError, TypeError, AttributeError):
+        raise RunnerError("opencode_model_not_connected") from None
+    if not models or len({model["id"] for model in models}) != len(models):
+        raise RunnerError("opencode_model_not_connected")
+    return models
diff --git a/src/laomedo/agents/artifacts/README.md b/src/laomedo/agents/artifacts/README.md
new file mode 100644
index 0000000000000000000000000000000000000000..6162283c1c383f5b11a5321fc2b973a3cdd89a59
--- /dev/null
+++ b/src/laomedo/agents/artifacts/README.md
@@ -0,0 +1,19 @@
+# Agent artifacts
+
+This package retains and transfers explicitly selected output files between Agent
+runs. `utils.py` owns selection, validation and file transfer. `ArtifactReference`
+in `models.py` is the canonical selected-file value. GitHub publication policy
+belongs to its authorized publisher.
+
+`selections` validates the retained selection list; `relative_path` validates a
+manifest path; `import_selected` validates references,
+ownership, paths and size before copying. These are standalone functions.
+`ArtifactError` exposes stable refusal codes. Retaining files is not
+proof that the originating run or a remote publication completed.
+## Selected file values
+
+`ArtifactReference` in `models.py` groups the six already admitted manifest
+fields. Typed preparation and handoff values retain those objects until the
+existing JSON boundary. Selection, protected-path checks, byte verification and
+filesystem effects remain in the owning artifact functions; a model is not an
+authorization grant. Dynamic path-to-hash inventories remain keyed maps.
