+            ):
+                with self.assertRaisesRegex(
+                    RunnerError, "unsupported_codex_cli_version"
+                ):
+                    LocalRunner(
+                        root / "state", root / "skills", source, image_id=approved
+                    )
+            docker.assert_not_called()
+            self.assertFalse((root / "state/turn-ledger.json").exists())
+
+    def test_local_image_override_rejects_tags_git_and_split_mode(self):
+        with tempfile.TemporaryDirectory() as temp:
+            root = Path(temp)
+            source = repository_root() / "components"
+            for image_id in ("latest", "sha256:bad", "sha256:" + "A" * 64):
+                with (
+                    self.subTest(image_id=image_id),
+                    self.assertRaisesRegex(RunnerError, "invalid_local_image_id"),
+                ):
+                    LocalRunner(
+                        root / "state", root / "skills", source, image_id=image_id
+                    )
+            with self.assertRaisesRegex(RunnerError, "invalid_local_image_id"):
+                LocalRunner(
+                    root / "state",
+                    root / "skills",
+                    source,
+                    image_id="sha256:" + "a" * 64,
+                    git_workspace=True,
+                )
+            with self.assertRaisesRegex(RunnerError, "invalid_local_image_id"):
+                LocalRunner(
+                    root / "state",
+                    root / "skills",
+                    source,
+                    image_id="sha256:" + "a" * 64,
+                    split_executor=True,
+                )
+
+    def test_claude_endpoint_configuration_maps_to_descriptive_code(self):
+        from laomedo.agents.agents.claude.container import ClaudeContainer
+        from py_docker.errors import ConnectionConfigurationError
+
+        with (
+            patch.object(ClaudeContainer, "check_supervisor"),
+            patch(
+                "py_docker.Client",
+                side_effect=ConnectionConfigurationError("select local endpoint"),
+            ),
+        ):
+            with self.assertRaisesRegex(
+                RunnerError, "claude_container_configuration_invalid"
+            ):
+                ClaudeContainer()
