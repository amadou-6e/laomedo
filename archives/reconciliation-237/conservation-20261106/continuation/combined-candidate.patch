-            row = self._owned(db, connection_id, owner)
-            if row["mode"] != "token":
-                raise ConnectionRefused("wrong_connection_mode")
-            verified = self._verify(
-                token,
-                row["account"],
-                row["repository"],
-                ("contents:write",),
-                "fine_grained",
-            )
