+                        attempt["capture_error"] = (
+                            "opencode_native_snapshot_unavailable"
+                        )
+                        record["evidence_complete"] = "partial"
+                if record is not None and record.get("status") == "completed":
+                    record.update(
+                        post_run_hash=self._freeze_workspace(root, record),
+                        snapshot_ready=True,
+                        output_ref=f"laomedo:run:{run_id}:workspace",
+                    )
+                if record is not None and attempt is not None:
+                    try:
+                        from laomedo.agents.agents.opencode.activity.telemetry import (
+                            export_attempt,
+                        )
+
+                        attempt["telemetry_complete"] = export_attempt(
+                            root,
+                            attempt["native_start"],
+                            record["thread_id"],
+                            record["requested_model"],
+                        )
+                    except Exception:
+                        attempt["telemetry_complete"] = False
+                        attempt.setdefault(
+                            "capture_error", "opencode_adapter_telemetry_incomplete"
+                        )
+                if record is not None:
+                    record["controller_cleanup"] = (
+                        "confirmed"
+                        if backend is not None
+                        and getattr(backend, "termination_verified", False)
+                        else "unverified"
+                    )
+                    if record.get("status") == "cancelled":
+                        record["cancel_confirmed"] = not launch_attempted or (
+                            backend is not None
+                            and getattr(backend, "termination_verified", False)
+                        )
+            except Exception as error:
+                cleanup_failure = failure_observation(
+                    error,
+                    stage="cleanup",
+                    code=(
+                        "opencode_transport_cleanup_failed"
+                        if not isinstance(error, RunnerError)
+                        else None
+                    ),
+                )
+                primary_failure = primary_failure or cleanup_failure
+                if record is not None:
+                    verified = backend is not None and getattr(
+                        backend, "termination_verified", False
+                    )
+                    record.update(
+                        status="failed",
+                        error_category=(
+                            str(error)
+                            if isinstance(error, RunnerError)
+                            else "opencode_transport_cleanup_failed"
+                        ),
+                        controller_cleanup="confirmed" if verified else "unverified",
+                        cancel_confirmed=False,
+                    )
+            finally:
+                try:
+                    if record is not None and attempt is not None:
+                        with self.control_lock:
+                            record["attempt_finished"] = True
+                            record["cancel_requested"] = bool(
+                                flag is not None and flag.is_set()
+                            )
+                            if record.get("status") != "completed":
+                                record.update(
+                                    snapshot_ready=False,
+                                    post_run_hash=None,
+                                    output_ref=None,
+                                )
+                            attempt.update(
+                                native_end=line_count(root / "activity-events.jsonl"),
+                                otel_end=line_count(root / "otel-events.jsonl"),
+                                status=record["status"],
+                                ended_at=now(),
+                            )
+                            _json(
+                                root / "activity-attempts" / (attempt["id"] + ".json"),
+                                attempt,
+                            )
+                            _json(root / "record.json", record)
+                finally:
+                    try:
+                        observed = getattr(backend, "cleanup_observed", None)
+                        if metadata_cleanup_unverified:
+                            observed = False
+                        source = (
+                            "opencode_owned_resources"
+                            if type(observed) is bool
+                            else None
+                        )
+                        self._retain_attempt_failure(
+                            root,
+                            record,
+                            attempt,
+                            primary_failure,
+                            cleanup_failure,
+                            cleanup_source=source,
+                            cleanup_verified=observed if source else None,
+                        )
+                    except Exception:
+                        pass
+                    finally:
+                        self.active_backends.pop(run_id, None)
+                        self.cancel_flags.pop(run_id, None)
+                        self.lock.release()
+        return record
+
+    def cancel(self, run_id):
+        record = self.status(run_id)
+        if record["status"] == "prepared":
+            with self.control_lock:
+                record = self.status(run_id)
+                if record["status"] == "prepared":
+                    record.update(
+                        status="cancelled",
+                        cancel_requested=True,
+                        cancel_confirmed=True,
+                        cancel_acknowledged=True,
+                        attempt_finished=True,
+                        controller_cleanup="not_launched",
+                    )
+                    _json(self._run_dir(run_id) / "record.json", record)
+                    return record
+        if record["status"] == "running":
+            flag = self.cancel_flags.get(run_id)
+            if flag is None:
+                current = self.status(run_id)
+                if current["status"] != "running":
+                    return current
+                raise RunnerError("run_not_active_in_this_process")
+            with self.control_lock:
+                current = self.status(run_id)
+                if current["status"] != "running":
+                    return current
+                flag.set()
+                current["cancel_requested"] = True
+                _json(self._run_dir(run_id) / "record.json", current)
+                record = current
+            backend = self.active_backends.get(run_id)
+            if backend is None or not record.get("thread_id"):
+                return {
+                    **record,
+                    "cancel_requested": True,
+                    "cancel_acknowledged": False,
+                    "termination_verified": False,
+                }
+            backend.cancel()
+            # An acknowledgement is not proof that a native child command terminated.
+            return {
+                **record,
+                "cancel_requested": True,
+                "cancel_acknowledged": False,
+                "termination_verified": False,
+            }
+        return record
