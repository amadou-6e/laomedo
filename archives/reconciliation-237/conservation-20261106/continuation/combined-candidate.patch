+                with self.assertRaisesRegex(RunnerError, "permission_preflight_failed"):
+                    runner.preflight()
+            self.assertEqual(server.preflight.await_count, 4)
+
+    def test_split_profile_failure_cleanup_keeps_endpoint(self):
