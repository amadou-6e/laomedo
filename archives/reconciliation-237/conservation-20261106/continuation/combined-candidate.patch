-            token = exchanged.get("token")
-            verified = self._verify(
-                token,
-                pending["account"],
-                pending["repository"],
-                ("contents:write",),
-                "app_user",
-            )
-            connection_id = secrets.token_urlsafe(18)
-            db.execute(
-                "INSERT INTO connections VALUES (?, ?, 'browser', ?, ?, 1, 'ready', ?, ?)",
-                (
-                    connection_id,
-                    owner,
-                    verified["account"],
-                    pending["repository"],
-                    token,
-                    verified["expires_at"],
-                ),
-            )
-            db.execute("DELETE FROM pending WHERE state=?", (state,))
